{
  "name": "cko-pm-payroll",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dynamic payroll automation for property-management freelance accounts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --pretty",
    "e2e": "node scripts/e2e.mjs",
    "retemplate": "esbuild scripts/retemplate.ts --bundle --platform=node --outfile=node_modules/.cache/retemplate.cjs --log-level=error && node node_modules/.cache/retemplate.cjs",
    "seed": "esbuild scripts/seed.ts --bundle --platform=node --outfile=node_modules/.cache/seed.cjs --log-level=error && node node_modules/.cache/seed.cjs",
    "e2e:auth": "node scripts/e2e-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
